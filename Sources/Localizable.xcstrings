{
  "sourceLanguage": "en",
  "strings": {
    "A cat has settled in": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat s’est installé"
          }
        }
      }
    },
    "Allow Cat Is Coming in Privacy & Security › Accessibility.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Cat Is Coming dans Confidentialité et sécurité › Accessibilité."
          }
        }
      }
    },
    "Allow Cat Is Coming in System Settings › Notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Cat Is Coming dans Réglages Système › Notifications."
          }
        }
      }
    },
    "Allow Input Locking…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le verrouillage…"
          }
        }
      }
    },
    "Allow Notifications…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les notifications…"
          }
        }
      }
    },
    "A long press on any regular key can lock the keyboard. Turn this off in games or apps that use long presses.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui prolongé sur une touche peut verrouiller le clavier. Désactive cette option dans les jeux ou les apps où tu maintiens des touches."
          }
        }
      }
    },
    "A paw is holding a key": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une patoune sur une touche"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        }
      }
    },
    "Adjust Thresholds": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster les seuils"
          }
        }
      }
    },
    "Allow Accessibility in System Settings so Cat Is Coming can lock your keyboard and mouse.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’accès dans les Réglages Système pour que Cat Is Coming puisse verrouiller le clavier et la souris."
          }
        }
      }
    },
    "Allow banners in System Settings › Notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les bannières dans Réglages Système › Notifications."
          }
        }
      }
    },
    "Allow banners to get notified after using an unlock shortcut.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les bannières pour être prévenu après un raccourci de déverrouillage."
          }
        }
      }
    },
    "Automatic Lock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage automatique"
          }
        }
      }
    },
    "Cat Is Coming": {
      "shouldTranslate": false
    },
    "Cat Is Coming Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages de Cat Is Coming"
          }
        }
      }
    },
    "Confirm the login item in System Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme l’ouverture dans les Réglages Système."
          }
        }
      }
    },
    "Control, Shift, and Escape": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle, Majuscule et Échap"
          }
        }
      }
    },
    "Couldn’t change the login setting. %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier l’ouverture à la connexion. %@"
          }
        }
      }
    },
    "Couldn’t create the image.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer l’image."
