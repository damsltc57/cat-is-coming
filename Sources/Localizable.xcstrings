      }
    },
    "macOS couldn’t start the input filter. Check the permission and reopen the app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas activé le filtre. Vérifie l’autorisation puis relance l’app."
          }
        }
      }
    },
    "macOS interrupted the input filter. Click Try Again to restart it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a interrompu le filtre. Clique sur Réessayer pour le réactiver."
          }
        }
      }
    },
    "macOS stopped freezing the pointer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a interrompu le gel du pointeur."
