    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        }
      }
    },
    "Detects quick paw steps and keys held together. Your mouse stays available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte les passages rapides et les touches maintenues ensemble. La souris reste utilisable."
