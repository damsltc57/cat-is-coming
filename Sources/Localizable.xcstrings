        }
      }
    },
    "Esc": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échap"
          }
        }
      }
    },
    "Find the cat in your menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouve le chat dans la barre des menus."
          }
        }
